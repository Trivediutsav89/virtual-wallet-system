# Normalise line endings in the repo. Shell scripts MUST be LF or the
# containers fail with "no such file or directory: /bin/sh^M".
* text=auto eol=lf

*.sh        text eol=lf
*.py        text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.conf      text eol=lf
*.ini       text eol=lf
Dockerfile  text eol=lf

*.ps1       text eol=crlf
*.cmd       text eol=crlf
*.bat       text eol=crlf

*.png       binary
*.jpg       binary
*.ico       binary
