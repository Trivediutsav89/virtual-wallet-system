# ---------------------------------------------------------------------------
# Template for the root .env consumed by docker compose and the services.
# Copy to .env and replace every `change-me*` value.
#
#   cp .env.example .env
#   # generate real secrets:
#   python -c "import secrets; print(secrets.token_hex(32))"
#
# Secrets are dev-only. In any real deployment use a secret manager and
# injection at runtime; never bake values into images.
# ---------------------------------------------------------------------------

# local | test | ci | prod
APP_ENV=local
LOG_LEVEL=INFO

# --- Postgres superuser (bootstrap/init scripts only) ----------------------
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=change-me-superuser

# --- Per-service database roles -------------------------------------------
# Use URL-safe characters only (hex recommended): these are interpolated into
# postgresql+asyncpg:// DSNs.
AUTH_DB_PASSWORD=change-me-auth-db
PROFILE_DB_PASSWORD=change-me-profile-db
WALLET_DB_PASSWORD=change-me-wallet-db

# --- JWT ------------------------------------------------------------------
# Shared by auth (signs) and gateway (verifies). Minimum 32 characters.
JWT_SECRET=change-me-please-generate-a-32-byte-hex-secret
JWT_ALGORITHM=HS256
JWT_ISSUER=virtual-wallet-auth
ACCESS_TOKEN_TTL_MINUTES=30
BCRYPT_COST=12

# --- Gateway --------------------------------------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT=120/min
RATE_LIMIT_AUTH=10/min
HTTP_TIMEOUT_SECONDS=10
# Only enable behind a proxy you control: X-Forwarded-For is client-spoofable.
TRUST_FORWARDED_FOR=false
CORS_ORIGINS=http://localhost:3000

# --- Host port mappings (remapped to avoid local conflicts) ----------------
POSTGRES_HOST_PORT=5433
REDIS_HOST_PORT=6380
GATEWAY_HOST_PORT=8000
AUTH_HOST_PORT=8001
PROFILE_HOST_PORT=8002
WALLET_HOST_PORT=8003

# --- Test databases (integration tests only; not read by the services) -----
# Must point at the *_db_test database, never at the runtime one.
AUTH_TEST_DATABASE_URL=postgresql+asyncpg://auth_svc:change-me-auth-db@localhost:5433/auth_db_test
PROFILE_TEST_DATABASE_URL=postgresql+asyncpg://profile_svc:change-me-profile-db@localhost:5433/profile_db_test
WALLET_TEST_DATABASE_URL=postgresql+asyncpg://wallet_svc:change-me-wallet-db@localhost:5433/wallet_db_test
